+int CTCSocket::slotOf(int fd) const
+{
+	for (unsigned i=0; i<m_Pfd.size(); i++)
+		if (fd == m_Pfd[i].fd)
+			return int(i);
+	return -1;
+}
+
+// v2 framing: read what is there, then take every complete frame out of
+// the reassembly buffer. A bad frame is counted and skipped; the link is
+// closed only after kV2MaxBadRun bad frames in a row. The first bad
+// frame of a burst is logged, and so is the recovery.
+void CTCSocket::receiveV2(int fd, std::queue<std::unique_ptr<STCPacket>> &queue)
+{
+	const int slot = slotOf(fd);
+	if (slot < 0 || std::size_t(slot) >= m_Rx.size())
+	{
+		Close(fd);
+		return;
+	}
+	uint8_t buf[4096];
+	ssize_t n;
+	do {
+		n = recv(fd, buf, sizeof(buf), MSG_DONTWAIT);
+	} while (n < 0 && EINTR == errno);
+	if (n < 0 && (EAGAIN == errno || EWOULDBLOCK == errno))
+		return;
+	if (n <= 0)
+	{
+		if (n < 0)
+			perror("receiveV2 recv");
+		Close(fd);
+		return;
+	}
+	auto &rx = m_Rx[slot];
+	rx.Append(buf, std::size_t(n));
+	const char mod = m_Modules[slot];
+	for (;;)
+	{
+		auto p = std::make_unique<STCPacket>();
+		const char *why = nullptr;
+		const unsigned badBefore = rx.BadRun();
+		const std::size_t skippedBefore = rx.Skipped();
+		auto st = rx.Next(*p, why);
+		if (EV2Status::need_more == st)
+			return;
+		if (EV2Status::packet == st)
+		{
+			if (badBefore > 0)
+				std::cerr << "Module '" << mod << "': v2 link in step again after " << badBefore << " bad frame(s), " << skippedBefore << " byte(s) skipped" << std::endl;
+			if (ECodecType::ping != p->codec_in && p->module != mod)
+			{
+				why = "packet names another module";
+				st = rx.RefusePacket(why);
+			}
+			else
+			{
+				if (ECodecType::ping != p->codec_in)
+					queue.push(std::move(p));
+				continue;
+			}
+		}
+		if (1 == rx.BadRun() || EV2Status::too_many_bad == st)
+			std::cerr << "Module '" << mod << "': bad v2 frame: " << why << " (" << rx.BadTotal() << " bad so far)" << std::endl;
+		if (EV2Status::too_many_bad == st)
+		{
+			std::cerr << "Module '" << mod << "': " << rx.BadRun() << " bad v2 frames in a row, closing the link" << std::endl;
+			Close(fd);
+			return;
+		}
+	}
+}
+
 // A packet on the link of one module must name that module. A ping
 // carries no data and is not checked. Logs the first mismatch on each
 // module and then every 100th, so a broken peer cannot flood the log.
