diff --git a/TCFraming.cpp b/TCFraming.cpp
new file mode 100644
index 0000000..1c38ffa
--- /dev/null
+++ b/TCFraming.cpp
@@ -0,0 +1,164 @@
+// Optional v2 framing for the reflector <-> tcd link. See TCFraming.h.
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+
+#include <cstring>
+#include <algorithm>
+
+#include "TCFraming.h"
+
+uint32_t Crc32Ieee(const uint8_t *data, std::size_t len)
+{
+	static uint32_t table[256];
+	static bool ready = false;
+	if (! ready)
+	{
+		for (uint32_t i = 0; i < 256; i++)
+		{
+			uint32_t c = i;
+			for (int k = 0; k < 8; k++)
+				c = (c & 1) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
+			table[i] = c;
+		}
+		ready = true;
+	}
+	uint32_t crc = 0xFFFFFFFFu;
+	for (std::size_t i = 0; i < len; i++)
+		crc = table[(crc ^ data[i]) & 0xFFu] ^ (crc >> 8);
+	return crc ^ 0xFFFFFFFFu;
+}
+
+void EncodeV2Frame(const STCPacket &packet, uint8_t *out)
+{
+	memcpy(out, kV2Magic, 4);
+	out[4] = kV2Version;
+	out[5] = 0;
+	out[6] = uint8_t(TCPacketWireSize & 0xFF);
+	out[7] = uint8_t(TCPacketWireSize >> 8);
+	EncodeTCPacket(packet, out + kV2HeaderSize);
+	const uint32_t crc = Crc32Ieee(out + 4, 4 + TCPacketWireSize);
+	uint8_t *t = out + kV2HeaderSize + TCPacketWireSize;
+	t[0] = uint8_t(crc);
+	t[1] = uint8_t(crc >> 8);
+	t[2] = uint8_t(crc >> 16);
+	t[3] = uint8_t(crc >> 24);
+}
+
+void CV2Reader::Reset()
+{
+	m_Buf.clear();
+	m_Start = 0;
+	m_InGarbage = false;
+	m_BadRun = 0;
+	m_Skipped = 0;
+}
+
+void CV2Reader::Append(const uint8_t *data, std::size_t len)
+{
+	if (m_Start > 0 && m_Start >= m_Buf.size() / 2)
+	{
+		m_Buf.erase(m_Buf.begin(), m_Buf.begin() + m_Start);
+		m_Start = 0;
+	}
+	m_Buf.insert(m_Buf.end(), data, data + len);
+}
+
+void CV2Reader::drop(std::size_t n)
+{
+	m_Start += n;
+	if (m_Start >= m_Buf.size())
+	{
+		m_Buf.clear();
+		m_Start = 0;
+	}
+}
+
+EV2Status CV2Reader::bad(const char *reason, const char *&why)
+{
+	why = reason;
+	m_BadRun++;
+	m_BadTotal++;
+	// The bytes after a bad frame are not in a frame either; do not count
+	// them again as a separate run of garbage.
+	m_InGarbage = true;
+	return (m_BadRun >= kV2MaxBadRun) ? EV2Status::too_many_bad : EV2Status::bad;
+}
+
+EV2Status CV2Reader::RefusePacket(const char *&why)
+{
+	return bad(why, why);
+}
+
+EV2Status CV2Reader::Next(STCPacket &packet, const char *&why)
+{
+	why = nullptr;
+	for (;;)
+	{
+		const uint8_t *p = m_Buf.data() + m_Start;
+		const std::size_t avail = m_Buf.size() - m_Start;
+		if (avail < 4)
+			return EV2Status::need_more;
+
+		// find the magic
+		const uint8_t *m = std::search(p, p + avail, kV2Magic, kV2Magic + 4);
+		std::size_t off = std::size_t(m - p);
+		if (off > 0)
+		{
+			// Bytes outside a frame. Keep a tail that can be the start
+			// of a magic that is not complete yet.
+			std::size_t skip = (m == p + avail) ? avail - 3 : off;
+			drop(skip);
+			m_Skipped += skip;
+			if (m_Skipped > kV2MaxGarbage)
+			{
+				why = "too many bytes outside a frame";
+				return EV2Status::too_many_bad;
+			}
+			if (! m_InGarbage)
+				return bad("bytes outside a frame", why);
+			if (m == p + avail)
+				return EV2Status::need_more;
+			continue;
+		}
+
+		// a magic at the start of the buffer
+		if (avail < kV2HeaderSize)
+			return EV2Status::need_more;
+		if (p[4] != kV2Version)
+		{
+			drop(1);
+			m_Skipped++;
+			return bad("unknown frame version", why);
+		}
+		const std::size_t plen = std::size_t(p[6]) | (std::size_t(p[7]) << 8);
+		if (plen < kV2MinPayload || plen > kV2MaxPayload)
+		{
+			drop(1);
+			m_Skipped++;
+			return bad("frame length out of range", why);
+		}
+		const std::size_t total = kV2HeaderSize + plen + kV2TrailerSize;
+		if (avail < total)
+			return EV2Status::need_more;
+		const uint8_t *t = p + kV2HeaderSize + plen;
+		const uint32_t got = uint32_t(t[0]) | (uint32_t(t[1]) << 8) | (uint32_t(t[2]) << 16) | (uint32_t(t[3]) << 24);
+		if (got != Crc32Ieee(p + 4, 4 + plen))
+		{
+			drop(1);
+			m_Skipped++;
+			return bad("frame CRC mismatch", why);
+		}
+		const char *reason = DecodeTCPacket(p + kV2HeaderSize, packet);
+		drop(total);
+		if (reason)
+			return bad(reason, why);
+		m_InGarbage = false;
+		m_BadRun = 0;
+		m_Skipped = 0;
+		m_Good++;
+		return EV2Status::packet;
+	}
+}
diff --git a/TCFraming.h b/TCFraming.h
new file mode 100644
index 0000000..c54907a
--- /dev/null
+++ b/TCFraming.h
@@ -0,0 +1,84 @@
+#pragma once
+
+// Optional "v2" framing for the reflector <-> tcd link.
+//
+// Why: with raw framing the link is a plain run of 376-byte packets. One
+// lost, extra or changed byte puts every later packet out of step, and
+// the only cure is to drop the link. v2 wraps each packet in a frame with
+// a magic, a version, a length and a CRC, so a reader can find the next
+// good frame and go on. v2 is off by default (tcd.ini: Framing = raw), so
+// an unchanged reflector keeps working. Both ends must use the same mode.
+//
+// Connection: tcd still sends its one module-letter byte first, without
+// a frame. After that byte every packet in both directions, pings too,
+// is one v2 frame:
+//
+//   0  4  magic "TCD2" (0x54 0x43 0x44 0x32)
+//   4  1  version, 1
+//   5  1  flags, 0 (ignored on read)
+//   6  2  payload length, u16 little-endian (376 for this version;
+//         a reader accepts 376..1024 and ignores bytes after 376)
+//   8  n  payload: the packet in the explicit encoding of TCPacketCodec.h
+// 8+n 4  CRC-32 (IEEE 802.3, as zlib crc32) of bytes 4..8+n-1, u32 LE
+//
+// A reader that finds a bad frame (bad version, length or CRC, or bytes
+// that are not in a frame) counts it, skips forward to the next magic
+// and goes on. It drops the link only after kV2MaxBadRun bad frames with
+// no good frame between them.
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "TCPacketDef.h"
+#include "TCPacketCodec.h"
+
+enum class EFraming { raw, v2 };
+
+constexpr uint8_t     kV2Magic[4]      = { 'T', 'C', 'D', '2' };
+constexpr uint8_t     kV2Version       = 1;
+constexpr std::size_t kV2HeaderSize    = 8;
+constexpr std::size_t kV2TrailerSize   = 4;
+constexpr std::size_t kV2MinPayload    = TCPacketWireSize;
+constexpr std::size_t kV2MaxPayload    = 1024;
+constexpr std::size_t kV2FrameSize     = kV2HeaderSize + TCPacketWireSize + kV2TrailerSize; // 388
+constexpr unsigned    kV2MaxBadRun     = 8;
+constexpr std::size_t kV2MaxGarbage    = 64 * 1024;
+
+// CRC-32/IEEE (reflected 0xEDB88320, init and final XOR 0xFFFFFFFF).
+uint32_t Crc32Ieee(const uint8_t *data, std::size_t len);
+
+// Write one v2 frame for packet to out (kV2FrameSize bytes).
+void EncodeV2Frame(const STCPacket &packet, uint8_t *out);
+
+enum class EV2Status { packet, need_more, bad, too_many_bad };
+
+// Reassembles v2 frames from a byte stream.
+class CV2Reader
+{
+public:
+	void Reset();
+	void Append(const uint8_t *data, std::size_t len);
+	// Gets the next result. On EV2Status::bad and too_many_bad, why says
+	// what was wrong. Call again until need_more.
+	EV2Status Next(STCPacket &packet, const char *&why);
+	// Counts a well-formed frame whose content the caller refused.
+	EV2Status RefusePacket(const char *&why);
+
+	unsigned BadRun() const { return m_BadRun; }
+	unsigned long BadTotal() const { return m_BadTotal; }
+	unsigned long Good() const { return m_Good; }
+	std::size_t Skipped() const { return m_Skipped; }
+
+private:
+	EV2Status bad(const char *reason, const char *&why);
+	void drop(std::size_t n);
+
+	std::vector<uint8_t> m_Buf;
+	std::size_t m_Start = 0;
+	bool m_InGarbage = false;
+	unsigned m_BadRun = 0;
+	unsigned long m_BadTotal = 0;
+	unsigned long m_Good = 0;
+	std::size_t m_Skipped = 0;      // bytes skipped since the last good frame
+};
