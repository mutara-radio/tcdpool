+// DefaultOutputs: "all", or a list of dstar, dmr, m17, p25 and usrp,
+// separated by commas or spaces. Returns true on failure.
+bool CConfigure::parseOutputs(const std::string &value)
+{
+	std::string v(value);
+	std::transform(v.begin(), v.end(), v.begin(), ::tolower);
+	std::replace(v.begin(), v.end(), ',', ' ');
+	std::istringstream iss(v);
+	std::string name;
+	uint8_t m = 0;
+	while (iss >> name)
+	{
+		if (name == "all")
+			m |= kTCOutAll;
+		else if (name == "dstar")
+			m |= TCOut(ECodecType::dstar);
+		else if (name == "dmr")
+			m |= TCOut(ECodecType::dmr);
+		else if (name == "m17")
+			m |= TCOut(ECodecType::c2_3200);
+		else if (name == "p25")
+			m |= TCOut(ECodecType::p25);
+		else if (name == "usrp")
+			m |= TCOut(ECodecType::usrp);
+		else
+		{
+			std::cerr << "ERROR: " << DEFAULTOUTPUTS << ": unknown output '" << name << "' (use all, dstar, dmr, m17, p25, usrp). Halt." << std::endl;
+			return true;
+		}
+	}
+	if (0 == m)
+	{
+		std::cerr << "ERROR: " << DEFAULTOUTPUTS << " is empty. Halt." << std::endl;
+		return true;
+	}
+	default_outputs = m;
+	return false;
+}
