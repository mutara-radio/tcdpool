+STCPacket CTranscoderPacket::Reply() const
+{
+	STCPacket r = tcpacket;
+	if (! Wants(ECodecType::dstar))
+		memset(r.dstar, 0, sizeof(r.dstar));
+	if (! Wants(ECodecType::dmr))
+		memset(r.dmr, 0, sizeof(r.dmr));
+	if (! Wants(ECodecType::c2_3200))
+		memset(r.m17, 0, sizeof(r.m17));
+	if (! Wants(ECodecType::p25))
+		memset(r.p25, 0, sizeof(r.p25));
+	if (! Wants(ECodecType::usrp))
+		memset(r.usrp, 0, sizeof(r.usrp));
+	return r;
 }
 
