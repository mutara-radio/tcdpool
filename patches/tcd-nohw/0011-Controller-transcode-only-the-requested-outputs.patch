+// The input was decoded to audio. Give the audio to the encoder of
+// each requested output, and to no other encoder. The field of the
+// input codec is already set, so its own queue gets nothing.
+void CController::Route(std::shared_ptr<CTranscoderPacket> packet)
+{
+	const uint8_t need = packet->Needed();
+	if (need & TCOut(ECodecType::c2_3200))
+		codec2_queue.push(packet);
+	if (need & TCOut(ECodecType::dstar))
+		ambe_queue.push(packet);
+	if (need & TCOut(ECodecType::dmr))
+		swambe2_queue.push(packet);
+	if (need & TCOut(ECodecType::p25))
+		imbe_queue.push(packet);
+	if (need & TCOut(ECodecType::usrp))
+		usrp_queue.push(packet);
+}
+
+// Send the reply: the requested fields, every other field zero. The
+// v2 header tells the reflector which fields hold data.
 void CController::SendToReflector(std::shared_ptr<CTranscoderPacket> packet)
 {
+	const STCPacket reply = packet->Reply();
 	// send the packet over the socket
-	while (tcClient.Send(packet->GetTCPacket()))
+	while (tcClient.Send(&reply, packet->Want()))
 	{
 		tcClient.ReConnect();
 	}
