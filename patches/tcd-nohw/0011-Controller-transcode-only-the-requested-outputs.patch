diff --git a/TCPacketDef.h b/TCPacketDef.h
index 626f87e..3bd600c 100644
--- a/TCPacketDef.h
+++ b/TCPacketDef.h
@@ -28,6 +28,22 @@ enum class ECodecType : std::uint8_t { none = 0, dstar = 1, dmr = 2, c2_1600 = 3
 constexpr uint8_t TCOut(ECodecType c) { return uint8_t(1u << unsigned(c)); }
 constexpr uint8_t kTCOutAll = TCOut(ECodecType::dstar) | TCOut(ECodecType::dmr) | TCOut(ECodecType::c2_3200) | TCOut(ECodecType::p25) | TCOut(ECodecType::usrp);
 
+// The output bit of an input codec: codec2 input fills the m17 field.
+constexpr uint8_t TCOutOfInput(ECodecType c)
+{
+	return (ECodecType::c2_1600 == c) ? TCOut(ECodecType::c2_3200) : TCOut(c);
+}
+
+// Make a requested mask usable: the c2_1600 bit selects the m17 field,
+// unknown bits are dropped, and a mask with no known bit means all.
+constexpr uint8_t TCOutNormalize(uint8_t m)
+{
+	if (m & TCOut(ECodecType::c2_1600))
+		m |= TCOut(ECodecType::c2_3200);
+	m &= kTCOutAll;
+	return m ? m : kTCOutAll;
+}
