@@ -21,6 +21,13 @@
 
 enum class ECodecType : std::uint8_t { none = 0, dstar = 1, dmr = 2, c2_1600 = 3, c2_3200 = 4, p25 = 5, usrp = 6, ping = 0xff };
 
+// Requested outputs: a bit mask with bit n set for ECodecType n, for the
+// codec fields that the reflector wants filled in the reply. The m17
+// field is codec2 3200 (bit 4); bit 3 (c2_1600) also selects it, because
+// tcd can only encode codec2 3200. 0 means every codec.
+constexpr uint8_t TCOut(ECodecType c) { return uint8_t(1u << unsigned(c)); }
+constexpr uint8_t kTCOutAll = TCOut(ECodecType::dstar) | TCOut(ECodecType::dmr) | TCOut(ECodecType::c2_3200) | TCOut(ECodecType::p25) | TCOut(ECodecType::usrp);
+
 using STCPacket = struct tcpacket_tag {
 	uint32_t sequence;
 	char module;
